    "Files controls access to images beside your document. If needed, open the image folder from the reader.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos controla el acceso a las imágenes junto al documento. Si es necesario, abre la carpeta de imágenes desde el visor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“文件”控制对文档旁图像的访问。如有需要，请在阅读器中打开图像文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「檔案」控制對文件旁影像的取用權。如有需要，請在閱讀器中打開影像檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類と同じ場所にある画像へのアクセスは「ファイル」で管理されます。必要に応じてリーダーから画像フォルダを開いてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers contrôle l’accès aux images proches du document. Si nécessaire, ouvrez leur dossier depuis le lecteur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien verwaltet den Zugriff auf Bilder beim Dokument. Öffnen Sie bei Bedarf den Bilderordner im Leser."
          }
        }
      }
    },
