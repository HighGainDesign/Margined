    "Keeps the checkmarks already saved. Clicking a checkbox again asks before saving further changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva las casillas ya guardadas. Al pulsar otra casilla se pedirá permiso antes de guardar más cambios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已保存的勾选。再次点按复选框时，会先询问再保存后续更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已儲存的勾選。再次按下核取方塊時，會先詢問再儲存後續變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのチェックは保持します。次にチェックをクリックすると、保存前に再び確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les coches déjà enregistrées. Un nouveau clic sur une case demande confirmation avant tout autre enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gespeicherte Häkchen bleiben erhalten. Beim nächsten Klick wird vor weiteren Speicherungen erneut gefragt."
          }
        }
      }
    },
