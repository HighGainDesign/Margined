    "Resume Updates to show the latest saved version. Checkmarks cannot save while a newer version is waiting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda las actualizaciones para ver la última versión guardada. No se pueden guardar casillas si hay una versión más reciente pendiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复更新以显示最新保存版本。有较新版本等待时无法保存勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續更新以顯示最新儲存版本。有較新版本等候時無法儲存勾選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新を再開すると最新の保存済みバージョンを表示します。新しいバージョンがある間はチェックを保存できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez les mises à jour pour afficher la dernière version enregistrée. Les coches ne peuvent pas être enregistrées si une nouvelle version attend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die Aktualisierung fort, um die neueste gespeicherte Version zu sehen. Solange eine neuere Version wartet, können Häkchen nicht gespeichert werden."
          }
        }
      }
    },
