    "Voice language": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma de la voz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音語言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の言語"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de la voix"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache der Stimme"
          }
        }
      }
    },
    "Voices are provided by macOS. Add more in Accessibility settings. Document language is detected or chosen in Reading options; it is independent of the interface language.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS proporciona las voces. Añade más en Accesibilidad. El idioma del documento se detecta o se elige en Opciones de lectura; es independiente del idioma de la interfaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音由 macOS 提供，可在辅助功能设置中添加。文档语言可自动检测或在“阅读选项”中选择，与界面语言无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音由 macOS 提供，可在輔助使用設定中加入。文件語言可自動偵測或在「閱讀選項」中選擇，與介面語言無關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はmacOSが提供します。アクセシビリティ設定で追加できます。書類の言語は自動検出または閲覧オプションで選択でき、表示言語とは独立しています。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix sont fournies par macOS. Ajoutez-en dans Accessibilité. La langue du document est détectée ou choisie dans Options de lecture, indépendamment de l’interface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS stellt die Stimmen bereit. Weitere lassen sich unter Bedienungshilfen hinzufügen. Die Dokumentsprache wird erkannt oder in den Leseoptionen gewählt und ist unabhängig von der Oberfläche."
          }
        }
      }
    },
    "Wait for the document to finish loading, then try Read Aloud again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que el documento termine de cargar y vuelve a iniciar la lectura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待文档载入完成，再尝试朗读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待文件載入完成，再嘗試朗讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の読み込みが終わってから、もう一度読み上げを試してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin du chargement, puis réessayez la lecture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis das Dokument geladen ist, und versuche das Vorlesen erneut."
          }
        }
      }
    },
    "Waiting for a live stream": {
      "localizations": {
