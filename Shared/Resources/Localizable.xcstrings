    "On iOS 27, Files currently shows Markdown as plain text instead of using Margined’s Quick Look extension. This also affects some earlier iOS releases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS 27, Files currently shows Markdown as plain text instead of using Margined’s Quick Look extension. This also affects some earlier iOS releases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS 27, Archivos muestra actualmente Markdown como texto sin formato en lugar de usar la extensión Vista rápida de Margined. También ocurre en algunas versiones anteriores de iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 27 上，“文件”目前将 Markdown 显示为纯文本，而不使用 Margined 的快速查看扩展。部分较早的 iOS 版本也有此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 27 上，「檔案」目前將 Markdown 顯示為純文字，而不使用 Margined 的快速查看延伸功能。部分較早的 iOS 版本也有此問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27の「ファイル」では現在、Marginedのクイックルック拡張機能が使われず、Markdownがプレーンテキストで表示されます。一部の以前のiOSバージョンでも発生します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous iOS 27, Fichiers affiche actuellement le Markdown en texte brut au lieu d’utiliser l’extension Coup d’œil de Margined. Certaines versions antérieures d’iOS sont aussi concernées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter iOS 27 zeigt „Dateien“ Markdown derzeit als einfachen Text an, statt die Übersicht-Erweiterung von Margined zu verwenden. Das betrifft auch einige frühere iOS-Versionen."
          }
        }
      }
    },
    "Choose Open With → Margined or Share → Margined to open the formatted document.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Open With → Margined or Share → Margined to open the formatted document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Abrir con → Margined o Compartir → Margined para abrir el documento con formato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“打开方式”→“Margined”或“共享”→“Margined”，打开排版后的文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「打開方式」→「Margined」或「分享」→「Margined」，開啟排版後的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「このアプリで開く」→「Margined」、または「共有」→「Margined」を選ぶと、書式付きの文書を開けます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Ouvrir avec → Margined ou Partager → Margined pour ouvrir le document mis en forme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Öffnen mit“ → Margined oder „Teilen“ → Margined, um das formatierte Dokument zu öffnen."
          }
        }
      }
    },
    "You can reopen this guide from Settings → Getting Started.": {
      "extractionState": "manual",
      "localizations": {
