    "Each checkbox change saves automatically to the Markdown file. You can undo it. Other apps and agents will see your progress.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio de casilla se guarda automáticamente en el archivo Markdown. Puedes deshacerlo. Otras apps y agentes verán tu progreso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次更改复选框都会自动保存到 Markdown 文件。你可以撤销更改。其他 App 和智能体将能看到你的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次變更核取方塊都會自動儲存到 Markdown 檔案。你可以還原變更。其他 App 和代理程式將能看到你的進度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックボックスの変更は Markdown ファイルに自動保存されます。取り消すこともできます。他のアプリやエージェントにも進捗が反映されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement de case est enregistré automatiquement dans le fichier Markdown. Vous pouvez l’annuler. Les autres apps et agents verront votre progression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung eines Kontrollkästchens wird automatisch in der Markdown-Datei gespeichert. Sie lässt sich widerrufen. Andere Apps und Agenten sehen Ihren Fortschritt."
          }
        }
      }
    },
    "File Updates On": {
      "localizations": {
