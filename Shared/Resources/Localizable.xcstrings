    },
    "Choose By Category → Quick Look, then enable Margined. Another enabled Markdown previewer may take priority.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Por categoría → Vista Rápida y activa Margined. Otro visor Markdown activado podría tener prioridad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“按类别”→“快速查看”，然后启用 Margined。其他已启用的 Markdown 预览器可能优先使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「依類別」→「快速查看」，然後啟用 Margined。其他已啟用的 Markdown 預覽工具可能優先使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「カテゴリ別」→「クイックルック」でMarginedを有効にします。他のMarkdownプレビューが優先される場合があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Par catégorie → Coup d’œil, puis activez Margined. Un autre aperçu Markdown activé peut être prioritaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Nach Kategorie → Schnellvorschau und aktiviere Margined. Ein anderes aktives Markdown-Vorschauprogramm kann Vorrang haben."
          }
        }
      }
    },
    "Choose Quick Look, then enable Margined.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
