    "A discussion block has an uncertain boundary. Inspect its source before exporting a clean copy.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede determinar el límite de un bloque de discusión. Inspecciona su código fuente antes de exportar una copia sin comentarios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定某个讨论块的边界。导出无讨论副本前，请检查源文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定某個討論區塊的邊界。輸出無討論副本前，請檢查原始文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスカッションブロックの境界を特定できません。コメントなしのコピーを書き出す前に、ソースを確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites d’un bloc de discussion sont incertaines. Examinez son texte source avant d’exporter une copie sans discussions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grenzen eines Diskussionsblocks sind unklar. Prüfen Sie den Quelltext, bevor Sie eine Kopie ohne Diskussionen exportieren."
          }
        }
      }
    },
    "A save is in progress. Wait for it to finish.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está guardando. Espera a que termine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存，请等待完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存，請等待完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中です。完了するまでお待ちください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
