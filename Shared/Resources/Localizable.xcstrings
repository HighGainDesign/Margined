    "Load Remote Images in the document’s More menu contacts image hosts, which can reveal that you opened the document.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar imágenes remotas, en el menú Más del documento, contacta con sus servidores y puede revelar que abriste el documento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档“更多”菜单中的“加载远程图像”会联系图像服务器，这可能透露你打开了文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件「更多」選單中的「載入遠端影像」會連線至影像伺服器，這可能透露你開啟了文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の「その他」メニューでリモート画像を読み込むと、画像の配信元に接続し、書類を開いたことが伝わる可能性があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger les images distantes dans le menu Plus du document contacte leurs hébergeurs, qui peuvent savoir que vous avez ouvert le document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Entfernte Bilder laden“ im Menü „Mehr“ kontaktiert Bildserver. Dadurch können diese erfahren, dass Sie das Dokument geöffnet haben."
          }
        }
      }
    },
