    "Acknowledge every remaining change in this document": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar todos los cambios pendientes como revisados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文档中所有剩余更改标为已审阅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將文件中所有剩餘變更標為已檢閱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類の残りの変更をすべて確認済みにする"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer toutes les modifications restantes comme révisées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verbleibenden Änderungen als geprüft markieren"
          }
        }
      }
    },
