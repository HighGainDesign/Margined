    "Safe formatting and image sizes are supported. Scripts, forms and other active content are removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admiten formatos seguros y tamaños de imagen. Se eliminan scripts, formularios y otros contenidos activos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持安全格式和图像尺寸。脚本、表单和其他活动内容会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援安全格式和影像尺寸。指令碼、表單和其他主動式內容會被移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な書式と画像サイズ指定に対応しています。スクリプト、フォームなどの動的なコンテンツは削除されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en forme sûre et les dimensions d’images sont prises en charge. Les scripts, formulaires et autres contenus actifs sont supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Formatierung und Bildgrößen werden unterstützt. Skripte, Formulare und andere aktive Inhalte werden entfernt."
          }
        }
      }
    },
