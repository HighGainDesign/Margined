    "Attach this discussion to a new passage?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Vincular esta discusión a un nuevo pasaje?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此讨论关联到新段落？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此討論連結至新段落？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスカッションを新しい箇所に関連付けますか？"
          }
        },
        "fr": {
