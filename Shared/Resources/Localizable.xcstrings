    "Checkmarks in “%@” save automatically. Other text stays unchanged, and you can undo each change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las casillas de «%@» se guardan automáticamente. El resto del texto no cambia y puedes deshacer cada cambio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中的勾选会自动保存。其他文字保持不变，每次更改都可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」中的勾選會自動儲存。其他文字保持不變，每次變更都可復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のチェックは自動保存されます。他のテキストは変わらず、変更は個別に取り消せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coches de « %@ » sont enregistrées automatiquement. Le reste du texte ne change pas et chaque modification peut être annulée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häkchen in „%@“ werden automatisch gespeichert. Anderer Text bleibt unverändert. Jede Änderung lässt sich widerrufen."
          }
        }
      }
    },
    "Checkmarks save to this file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las casillas se guardan en este archivo."
