          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sicherungsvorgang läuft. Warten Sie, bis er abgeschlossen ist."
          }
        }
      }
    },
    "A shared message has different contents.": {
      "extractionState": "manual",
      "localizations": {
