    "Margined remembers positions in saved files using content hashes and offsets. It does not save document text or live streams in reading history.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Margined recuerda la posición en archivos guardados mediante hashes de contenido y desplazamientos. No guarda texto ni transmisiones en el historial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Margined 使用内容哈希和偏移量记住已保存文件中的位置。朗读记录不保存文档文字或实时流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Margined 使用內容雜湊和位移量記住已儲存檔案中的位置。朗讀記錄不儲存文件文字或即時串流。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Marginedは内容のハッシュと位置情報で保存済みファイルの再生位置を記憶します。履歴に書類のテキストやライブストリームは保存しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Margined mémorise les positions des fichiers enregistrés par empreintes et décalages. L’historique ne contient ni texte des documents ni flux en direct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Margined merkt sich Positionen in gespeicherten Dateien anhand von Inhalts-Hashes und Versätzen. Der Leseverlauf speichert weder Dokumenttext noch Live-Streams."
          }
        }
      }
    },
