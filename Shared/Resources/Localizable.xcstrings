    "Choose a folder containing this document’s images. Margined remembers access on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta que contenga las imágenes de este documento. Margined recordará el acceso en este Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含此文稿图像的文件夹。Margined 会在这台 Mac 上记住访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇包含此文件影像的檔案夾。Margined 會在這部 Mac 上記住存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類の画像が含まれるフォルダを選択してください。MarginedはこのMacでアクセス権を記憶します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier contenant les images de ce document. Margined mémorise l’accès sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner mit den Bildern dieses Dokuments. Margined merkt sich den Zugriff auf diesem Mac."
          }
        }
      }
    },
    "Folder access": {
      "extractionState": "manual",
