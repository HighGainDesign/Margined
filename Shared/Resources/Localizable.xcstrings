    "Local images": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes locales"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル画像"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images locales"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Bilder"
          }
        }
      }
    },
    "Local images load automatically from relative paths, absolute paths, file URLs and symlinks wherever macOS allows access. Margined does not require image-folder grants. Image formats are handled by WebKit. Quick Look supports embedded data images only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes locales se cargan automáticamente desde rutas relativas o absolutas, URL de archivo y enlaces simbólicos donde macOS permita el acceso. Margined no requiere permisos por carpeta. WebKit gestiona los formatos. Vista Rápida solo admite imágenes de datos incrustadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 macOS 允许访问，本地图片就会自动从相对路径、绝对路径、文件 URL 和符号链接载入。Margined 不要求授予图片文件夹权限。图片格式由 WebKit 处理。快速查看仅支持内嵌数据图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 macOS 允許存取，本機圖片就會自動從相對路徑、絕對路徑、檔案 URL 和符號連結載入。Margined 不要求授予圖片資料夾權限。圖片格式由 WebKit 處理。快速查看僅支援內嵌資料圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがアクセスを許可する場所では、相対・絶対パス、ファイルURL、シンボリックリンクから画像を自動で読み込みます。画像フォルダの許可は不要です。画像形式はWebKitが処理します。クイックルックは埋め込みデータ画像のみ対応します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images locales se chargent automatiquement depuis les chemins relatifs, absolus, URL de fichier et liens symboliques autorisés par macOS. Aucune autorisation de dossier n’est requise. WebKit gère les formats. Coup d’œil accepte uniquement les images de données intégrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Bilder laden automatisch über relative und absolute Pfade, Datei-URLs und symbolische Links, soweit macOS den Zugriff erlaubt. Keine Bildordner-Freigabe nötig. WebKit verarbeitet die Formate. Schnellvorschau unterstützt nur eingebettete Datenbilder."
          }
        }
      }
    },
