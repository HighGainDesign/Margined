        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此署名会保存在 Markdown 文件中，并非经验证的身份。以后更改署名只会影响之后的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此署名會儲存在 Markdown 檔案中，並非經驗證的身分。以後更改署名只會影響之後的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はMarkdownファイルに保存されます。本人確認済みの身元ではありません。後から変更しても、以降のメッセージにのみ適用されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom est enregistré dans le fichier Markdown. Il ne s’agit pas d’une identité vérifiée. Toute modification ultérieure ne concerne que les futurs messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
