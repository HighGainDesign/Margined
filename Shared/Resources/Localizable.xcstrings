    "Follow an editor’s Marked-compatible preview stream.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir la vista en directo del editor compatible con Marked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随编辑器的 Marked 兼容预览流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨編輯器的 Marked 相容預覽串流。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked互換エディタのプレビューストリームを表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
