    "This reply is already in the reloaded file. Keep the saved reply or edit your draft to post another.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta respuesta ya está en el archivo recargado. Conserva la respuesta guardada o edita el borrador para publicar otra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载的文件中已包含此回复。请保留已保存的回复，或编辑草稿以发布另一条回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入的檔案中已包含此回覆。請保留已儲存的回覆，或編輯草稿以發佈另一則回覆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込みしたファイルにはすでにこの返信があります。保存済みの返信を保持するか、下書きを編集して別の返信を投稿してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réponse figure déjà dans le fichier rechargé. Conservez la réponse enregistrée ou modifiez votre brouillon pour en publier une autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Antwort ist bereits in der neu geladenen Datei enthalten. Behalten Sie die gesicherte Antwort oder bearbeiten Sie Ihren Entwurf für eine weitere Antwort."
          }
        }
      }
    },
    "Thread state, target or metadata differs.": {
      "extractionState": "manual",
