    "A newer saved version is waiting. Resume updates to read it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una versión guardada más reciente. Reanuda las actualizaciones para leerla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的已保存版本。恢复更新即可阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的已儲存版本。繼續更新即可閱讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい保存済みバージョンがあります。更新を再開すると読めます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version enregistrée plus récente est disponible. Reprenez les mises à jour pour la lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere gespeicherte Version wartet. Setze die Aktualisierung fort, um sie zu lesen."
          }
        }
      }
    },
    "A newer version is waiting. Reading keeps the current version.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una versión más reciente. La lectura conserva la versión actual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的版本。朗读期间保留当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的版本。朗讀期間保留目前版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがあります。読み上げ中は現在のバージョンを保持します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version est disponible. La lecture conserve la version actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version wartet. Beim Vorlesen bleibt die aktuelle Version erhalten."
          }
        }
      }
    },
