          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“按类别”→“快速查看”，然后启用 Margined。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
