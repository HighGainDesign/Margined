    "Enable your editor’s Marked streaming preview integration, then start editing. In Drafts, use Settings → General. Marked can stay closed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la integración de vista en directo de Marked en tu editor y empieza a escribir. En Drafts, ve a Ajustes → General. Marked puede estar cerrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在编辑器中启用 Marked 实时预览集成，然后开始编辑。在 Drafts 中，打开 Settings → General。Marked 可保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在編輯器中啟用 Marked 即時預覽整合，然後開始編輯。在 Drafts 中，開啟 Settings → General。Marked 可保持關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタでMarkedのストリーミングプレビュー連携を有効にして編集を始めます。DraftsではSettings → Generalです。Markedを開く必要はありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’aperçu en continu compatible Marked dans votre éditeur, puis écrivez. Dans Drafts, ouvrez Settings → General. Marked peut rester fermé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Marked-Streaming-Vorschau im Editor und beginne zu schreiben. In Drafts unter Settings → General. Marked kann geschlossen bleiben."
          }
        }
      }
    },
