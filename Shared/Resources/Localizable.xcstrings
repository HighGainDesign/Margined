    "Opening a file doesn’t grant access to nearby images. Choose a folder that contains your document and its images; subfolders are included.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening a file doesn’t grant access to nearby images. Choose a folder that contains your document and its images; subfolders are included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir un archivo no da acceso a las imágenes cercanas. Selecciona una carpeta que contenga el documento y sus imágenes; se incluyen las subcarpetas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文件并不代表允许访问附近的图片。请选择一个包含文档及其图片的文件夹；其子文件夹也包含在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟檔案並不代表允許存取附近的圖片。請選擇包含文件及其圖片的檔案夾；其子檔案夾也包含在內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開くだけでは、周辺の画像へのアクセスは許可されません。文書と画像が入ったフォルダを選んでください。サブフォルダも含まれます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un fichier ne donne pas accès aux images voisines. Choisissez un dossier contenant le document et ses images ; les sous-dossiers sont inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Öffnen einer Datei erlaubt keinen Zugriff auf benachbarte Bilder. Wähle einen Ordner mit dem Dokument und seinen Bildern; Unterordner sind eingeschlossen."
          }
        }
      }
    },
    "You can select all of Dropbox when Files allows it, or remember several smaller folders. Manage or forget them in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select all of Dropbox when Files allows it, or remember several smaller folders. Manage or forget them in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Archivos lo permite, puedes seleccionar todo Dropbox o recordar varias carpetas más pequeñas. Adminístralas o elimina su acceso en Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果“文件”允许，你可以选择整个 Dropbox，也可以记住多个较小的文件夹。在“设置”中管理或移除它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果「檔案」允許，你可以選擇整個 Dropbox，也可以記住多個較小的檔案夾。在「設定」中管理或移除它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」で選択できる場合はDropbox全体を選べます。複数の小さなフォルダを記憶させることもできます。「設定」で管理や登録解除ができます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Fichiers le permet, vous pouvez sélectionner tout Dropbox ou mémoriser plusieurs dossiers plus petits. Gérez-les ou retirez-les dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn „Dateien“ es erlaubt, kannst du ganz Dropbox auswählen oder mehrere kleinere Ordner merken lassen. Verwalte oder entferne sie in den Einstellungen."
          }
        }
      }
    },
