    "Saved file changes appear automatically. Use Review Changes to compare with the last version you marked reviewed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios guardados aparecen automáticamente. Usa Revisar cambios para compararlos con la última versión revisada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的文件更改会自动显示。使用“审阅更改”与上次标为已审阅的版本比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的檔案變更會自動顯示。使用「檢閱變更」與上次標為已檢閱的版本比較。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された変更は自動で表示されます。「変更を確認」で前回確認済みにしたバージョンと比較できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
